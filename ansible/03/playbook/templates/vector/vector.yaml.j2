data_dir: /var/lib/vector
sources:
  local_logs:
    type: file
    include:
      - /var/log/messages
      - /var/log/secure
    read_from: beginning
sinks:
  clickhouse:
    type: clickhouse
    inputs:
      - local_logs
    endpoint: "http://{{ clickhouse_ip }}:8123"
    database: {{ clickhouse_database }}
    table: events
    compression: gzip
    healthcheck:
      enabled: false
    batch:
      max_events: 10
      timeout_secs: 1