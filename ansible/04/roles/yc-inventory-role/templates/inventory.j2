---
# Ansible inventory generated by yc-inventory-role
# Total VMs: {{ vm_details | length }}

all:
  vars:
    ansible_connection: ssh
    ansible_ssh_common_args: '-o StrictHostKeyChecking=no'
    ansible_user: {{ vm_user }}
    ansible_ssh_private_key_file: {{ ssh_key_path | expanduser }}
    yc_folder_id: {{ folder_id }}
    yc_subnet: {{ subnet_name }}
    yc_image: {{ image_family }}

# Группа всех VM
all_vms:
  hosts:
{% for vm in vm_details %}
    {{ vm.name }}:
      ansible_host: {{ vm.public_ip if vm.public_ip else vm.private_ip }}
      ansible_user: {{ vm_user }}
      ansible_ssh_private_key_file: {{ ssh_key_path | expanduser }}
      private_ip: {{ vm.private_ip }}
{% if vm.public_ip %}
      public_ip: {{ vm.public_ip }}
{% endif %}
      fqdn: {{ vm.fqdn }}
      vm_id: {{ vm.id }}
      zone: {{ vm.zone }}
      status: {{ vm.status }}
      created_at: {{ vm.created_at }}
      cores: {{ vm.resources.cores }}
      memory_gb: {{ (vm.resources.memory | int / 1024 / 1024 / 1024) | round(1) }}
      labels:
{% for key, value in vm.labels.items() %}
        {{ key }}: {{ value }}
{% endfor %}
{% endfor %}

# Группы по метке ansible_group
{% for vm in vm_details %}
{% if vm.labels.ansible_group is defined and vm.labels.ansible_group | length > 0 %}
{{ vm.labels.ansible_group }}:
  hosts:
    {{ vm.name }}:
      ansible_host: {{ vm.public_ip if vm.public_ip else vm.private_ip }}
      ansible_user: {{ vm_user }}
      ansible_ssh_private_key_file: {{ ssh_key_path | expanduser }}
      private_ip: {{ vm.private_ip }}
{% if vm.public_ip %}
      public_ip: {{ vm.public_ip }}
{% endif %}
      fqdn: {{ vm.fqdn }}
      vm_id: {{ vm.id }}
      zone: {{ vm.zone }}
      status: {{ vm.status }}
      created_at: {{ vm.created_at }}
      cores: {{ vm.resources.cores }}
      memory_gb: {{ (vm.resources.memory | int / 1024 / 1024 / 1024) | round(1) }}
      labels:
{% for key, value in vm.labels.items() %}
        {{ key }}: {{ value }}
{% endfor %}
{% endif %}
{% endfor %}

# Группы по ролям (role_*)
{% for vm in vm_details %}
{% if vm.labels.role is defined and vm.labels.role | length > 0 %}
role_{{ vm.labels.role }}:
  hosts:
    {{ vm.name }}:
      ansible_host: {{ vm.public_ip if vm.public_ip else vm.private_ip }}
      ansible_user: {{ vm_user }}
      ansible_ssh_private_key_file: {{ ssh_key_path | expanduser }}
      private_ip: {{ vm.private_ip }}
{% if vm.public_ip %}
      public_ip: {{ vm.public_ip }}
{% endif %}
      fqdn: {{ vm.fqdn }}
      vm_id: {{ vm.id }}
      zone: {{ vm.zone }}
      status: {{ vm.status }}
      created_at: {{ vm.created_at }}
      cores: {{ vm.resources.cores }}
      memory_gb: {{ (vm.resources.memory | int / 1024 / 1024 / 1024) | round(1) }}
      labels:
{% for key, value in vm.labels.items() %}
        {{ key }}: {{ value }}
{% endfor %}
{% endif %}
{% endfor %}